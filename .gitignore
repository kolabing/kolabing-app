# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release credentials (#159). Both of these are keys to the App Store account —
# committing either is a credential leak, so they are ignored by name AND by
# extension.
.env.release
*.p8
**/private_keys/

# Xcode's per-project build directory. `flutter build ios` writes ~170 MB of
# XCBuildData/ manifests here; a `git add -A` swept 1361 of them into the repo
# once (commit 4d43119), so this is not hypothetical. The root `/build/` rule
# below is anchored and does not cover it.
ios/build/

# Design-system bundle output.
ds-bundle/
