<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the process start (#181). Black plus the K mark, the same
     pair the Dart splash and the iOS launch screen paint, so there is no white
     flash and no jump when Flutter's first frame lands. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
